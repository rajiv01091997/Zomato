        orders 
    set
        cart_id=?,
        coupon_code=?,
        coupon_discount=?,
        customer_id=?,
        delivery_address=?,
        delivery_charge=?,
        delivery_time=?,
        gross_amount=?,
        gst_amount=?,
        invoice_number=?,
        order_status=?,
        order_time=?,
        payment_id=?,
        payment_status=?,
        platform_fee=?,
        restaurant_id=?,
        rider_id=?,
        special_instructions=?,
        total_amount=?,
        update_time=?,
        version=? 
    where
        id=? 
        and version=?
